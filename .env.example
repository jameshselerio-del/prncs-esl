# Copy to .env.local and fill in. Both values are public (they ship in the static bundle).

# OAuth 2.0 Web client ID from Google Cloud Console → APIs & Services → Credentials.
# Authorized JavaScript origins: http://localhost:5173 and your GitHub Pages origin.
VITE_GOOGLE_CLIENT_ID=

# Apps Script web app URL (Deploy → New deployment → Web app), ends in /exec.
VITE_API_URL=

# Name shown on the sign-in page before the school name loads (optional).
VITE_APP_NAME=Komorebi English
